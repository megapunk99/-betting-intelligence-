# Betting Intelligence - Environment Configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# Minimum to start the web app - just do:  cp .env.example .env
# To get live predictions:
#   1. Get a free key at https://the-odds-api.com/
#   2. Set ODDS_API_KEY=your_key
#   3. Set ENABLE_LIVE_ODDS=true

# THE ONE REQUIRED THING - API key for FastAPI middleware
API_KEY=change-me-to-a-random-secret

# TheOddsAPI - get your free key at https://the-odds-api.com/
# Without this, web app runs but shows no games available
ODDS_API_KEY=your-api-key-here

# Live odds
# ENABLE_LIVE_ODDS=false
# ODDS_POLL_INTERVAL=30

# Stripe (optional - for subscriptions)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Redis (optional - for rate limiting, falls back to in-memory)
# REDIS_URL=redis://localhost:6379/0

# Web Server
# API_HOST=0.0.0.0
# API_PORT=8000

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=pretty
