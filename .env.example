# ── Betting Intelligence System - Environment Configuration ───────────────
# Copy this to .env and adjust for your environment.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/betting_intel.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/betting_intel

# Path to NBA data SQLite database
NBA_DB_PATH=./data/nba_data.db

# ── Data & Output ────────────────────────────────────────────────────────
DATA_DIR=./data
OUTPUT_DIR=./output

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json          # json or pretty
LOG_FILE=logs/system.log

# ── API Server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=info

# ── Monitoring ────────────────────────────────────────────────────────────
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090

# ── Kelly Staking ─────────────────────────────────────────────────────────
INITIAL_BANKROLL=10000.0
UNIT_SIZE=0.02
MAX_KELLY_FRACTION=0.25
MIN_EDGE_THRESHOLD=0.02

# ── Model Configuration ───────────────────────────────────────────────────
ENABLE_LINEAR_MODEL=true
ENABLE_XGBOOST_MODEL=true
ENABLE_ENSEMBLE=true
WALK_FORWARD_WINDOW=200
WALK_FORWARD_STEP=20
MIN_TRAIN_SAMPLES=50

# ── Security ──────────────────────────────────────────────────────────────
API_KEY=change-me-to-a-random-secret
CORS_ORIGINS=*
