# ═══════════════════════════════════════════════════════════════════════════
# Betting Intelligence System — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# On Windows (PowerShell):
#   Copy-Item .env.example .env
#
# Then edit .env with your actual API keys and settings.
# ═══════════════════════════════════════════════════════════════════════════

# ── Project Paths ──────────────────────────────────────────────────────────
# DATA_DIR=./data
# OUTPUT_DIR=./output
# LOGS_DIR=./logs

# ── Database ───────────────────────────────────────────────────────────────
# Connection URL. Supports SQLite (default) or PostgreSQL.
#   SQLite:  sqlite:///./data/betting_intel.db
#   PostgreSQL: postgresql+psycopg2://user:password@host:5432/betting_intel
# DATABASE_URL=sqlite:///./data/betting_intel.db

# Path to the NBA game logs SQLite database (legacy)
# NBA_DB_PATH=./data/nba_data.db

# ── Logging ────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
# Log format: "json" for structured JSON, "pretty" for human-readable
# LOG_FORMAT=pretty
# Optional path to a log file (e.g., ./logs/app.log)
# LOG_FILE=

# ── API Server ─────────────────────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8000
# API_WORKERS=4
# API_LOG_LEVEL=info
# API_KEY=change-me-to-a-random-secret
# CORS_ORIGINS=*

# ── Monitoring ─────────────────────────────────────────────────────────────
# ENABLE_PROMETHEUS=false
# PROMETHEUS_PORT=9090

# ── Kelly Staking ──────────────────────────────────────────────────────────
# Starting bankroll in dollars
# INITIAL_BANKROLL=10000.0
# Unit size as fraction of bankroll (2% = 0.02)
# UNIT_SIZE=0.02
# Maximum Kelly fraction (25% = 0.25)
# MAX_KELLY_FRACTION=0.25
# Minimum edge threshold to place a bet (2% = 0.02)
# MIN_EDGE_THRESHOLD=0.02

# ── Model Configuration ────────────────────────────────────────────────────
# ENABLE_LINEAR_MODEL=true
# ENABLE_XGBOOST_MODEL=true
# ENABLE_ENSEMBLE=true
# WALK_FORWARD_WINDOW=200
# WALK_FORWARD_STEP=20
# MIN_TRAIN_SAMPLES=50
# TEST_SIZE=0.20

# ── Rolling Windows for Feature Engineering ────────────────────────────────
# Comma-separated list of window sizes
# ROLLING_WINDOWS=3,5,10,20
# MAX_REST_DAYS=7

# ── Small League Configuration ─────────────────────────────────────────────
# Enable small-league data ingestion (LNB Pro B, CEBL, BNXT, WNBA, etc.)
# ENABLE_SMALL_LEAGUES=true
# Comma-separated list of active small leagues
# ACTIVE_SMALL_LEAGUES=lnb_pro_b,cebl,bnxt,wnba,euroleague_women,soccer_belgian_pro_league
# Optional cache directory for small-league data
# SMALL_LEAGUE_CACHE_DIR=
# Optional JSON config for historical seasons (advanced)
# SMALL_LEAGUE_HISTORICAL_SEASONS=

# ── Live Odds & API Keys ──────────────────────────────────────────────────
# Enable live odds polling
# ENABLE_LIVE_ODDS=false
# API key for TheOddsAPI (v4). Get one free at https://the-odds-api.com/
# ⚠ REQUIRED for live odds and --live mode
# ODDS_API_KEY=your-api-key-here
# Polling interval in seconds (10-300)
# ODDS_POLL_INTERVAL=30
# Minimum percentage change to emit line movement alert
# ODDS_MOVEMENT_THRESHOLD_PCT=2.0
# SQLite path for time-series odds snapshots
# ODDS_SNAPSHOTS_DB=./data/odds_snapshots.db

# ── Alert / Notification Configuration ────────────────────────────────────
# Master switch for all alert channels
# ENABLE_ALERTS=false

# Telegram Bot - get token from @BotFather on Telegram
# ENABLE_TELEGRAM=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord Webhook - get URL from Discord channel settings > Integrations
# ENABLE_DISCORD=false
# DISCORD_WEBHOOK_URL=

# Email Notifications (for pipeline events)
# ENABLE_EMAIL=false
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDR=
# SMTP_TO_ADDR=
# SMTP_USE_TLS=true

# ── Alert Thresholds ───────────────────────────────────────────────────────
# ALERT_MIN_EDGE_PCT=3.0
# ALERT_MIN_CONFIDENCE=0.55
# ALERT_MIN_STAKE=50.0
# ALERT_RATE_LIMIT_SECONDS=60

# ── Docker / PostgreSQL ────────────────────────────────────────────────────
# (Only used when running via docker-compose)
# POSTGRES_PASSWORD=changeme

# Grafana admin password (docker compose --profile monitoring)
# GRAFANA_PASSWORD=admin
