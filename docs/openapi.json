{
  "openapi": "3.0.3",
  "info": {
    "title": "Betting Intelligence API",
    "description": "AI-powered basketball betting recommendations. Real odds from TheOddsAPI + ESPN scraper, ML predictions, Kelly staking, and subscription management.\n\n## Data Sources\n- **TheOddsAPI** (tier 1): Primary source, requires API key\n- **ESPN Public API** (tier 2): Chrome-based stealth scraper, no key needed — automatic fallback when TheOddsAPI is unavailable",
    "version": "0.2.0",
    "contact": {
      "name": "Betting Intelligence",
      "url": "http://localhost:8000"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api": {
      "get": {
        "summary": "API Index",
        "description": "Returns a live catalog of every available endpoint with method, path, description, type, and category.",
        "operationId": "apiIndex",
        "tags": ["Meta"],
        "responses": {
          "200": {
            "description": "Endpoint catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "application": { "type": "string" },
                    "version": { "type": "string" },
                    "documentation": { "type": "string" },
                    "endpoints": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "method": { "type": "string" },
                          "path": { "type": "string" },
                          "description": { "type": "string" },
                          "type": { "type": "string" },
                          "category": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Full System Health",
        "description": "Returns status of ALL critical services: database, TheOddsAPI key status, Stripe key status, recommendation engine, live engine, and all circuit breaker states.",
        "operationId": "apiHealth",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Health status with service-level breakdown",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["ok", "degraded"] },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "version": { "type": "string" },
                    "uptime_seconds": { "type": "integer" },
                    "services": {
                      "type": "object",
                      "properties": {
                        "database": { "$ref": "#/components/schemas/ServiceStatus" },
                        "odds_api": { "$ref": "#/components/schemas/ServiceStatus" },
                        "stripe": { "$ref": "#/components/schemas/ServiceStatus" },
                        "engine": { "$ref": "#/components/schemas/EngineServiceStatus" }
                      }
                    },
                    "circuit_breakers": {
                      "type": "object",
                      "additionalProperties": { "$ref": "#/components/schemas/CircuitBreakerStatus" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health/live": {
      "get": {
        "summary": "Liveness Probe",
        "description": "Lightweight live probe for load balancers / Docker health checks. Returns immediately with no DB or service checks.",
        "operationId": "apiHealthLive",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Server is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "alive" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "summary": "Readiness Probe",
        "description": "Checks if critical services (database and engine) are available. Returns 503 if not ready.",
        "operationId": "apiHealthReady",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Services are ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ready" },
                    "engine": { "type": "boolean" },
                    "database": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "One or more services not ready"
          }
        }
      }
    },
    "/api/live/refresh": {
      "post": {
        "summary": "Manual Refresh — Fetch Fresh Odds",
        "description": "⚠️ MANUAL TRIGGER. Fetches fresh odds from TheOddsAPI (tier 1) or ESPN scraper (tier 2 fallback). This is the ONLY endpoint that triggers external API calls. All other endpoints return cached data only.",
        "operationId": "apiLiveRefresh",
        "tags": ["Live Predictions"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refresh completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "refreshed": { "type": "boolean" },
                    "n_live": { "type": "integer" },
                    "n_today": { "type": "integer" },
                    "n_tomorrow": { "type": "integer" },
                    "n_total": { "type": "integer" },
                    "fresh_odds": { "type": "boolean" },
                    "generated_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Engine unavailable"
          }
        }
      }
    },
    "/api/live/snapshot": {
      "get": {
        "summary": "Full Live Prediction Snapshot",
        "description": "Returns the complete live prediction snapshot: all games with real market odds (moneyline, spread, totals), predicted totals, edges, and confidence levels. All cached data — no API calls.",
        "operationId": "apiLiveSnapshot",
        "tags": ["Live Predictions"],
        "responses": {
          "200": {
            "description": "Full snapshot of all live + upcoming games",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "live_games": { "type": "array", "items": { "$ref": "#/components/schemas/LiveGame" } },
                    "today_games": { "type": "array", "items": { "$ref": "#/components/schemas/LiveGame" } },
                    "tomorrow_games": { "type": "array", "items": { "$ref": "#/components/schemas/LiveGame" } },
                    "next_two_days": { "type": "array", "items": { "$ref": "#/components/schemas/LiveGame" } },
                    "n_live": { "type": "integer" },
                    "n_today": { "type": "integer" },
                    "n_tomorrow": { "type": "integer" },
                    "n_total": { "type": "integer" },
                    "fresh_odds": { "type": "boolean" },
                    "generated_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/live/chart-data": {
      "get": {
        "summary": "Chart Data — Pre-computed Edges & Confidence",
        "description": "Returns pre-computed chart data: edge percentages per game, confidence breakdown (high/medium/low), and direction breakdown (over/under/neutral). Sub-100ms response.",
        "operationId": "apiLiveChartData",
        "tags": ["Live Predictions"],
        "responses": {
          "200": {
            "description": "Chart-ready data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "n_live": { "type": "integer" },
                    "n_today": { "type": "integer" },
                    "n_tomorrow": { "type": "integer" },
                    "n_total": { "type": "integer" },
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "matchup": { "type": "string" },
                          "edge_pct": { "type": "number" },
                          "predicted_total": { "type": "number" },
                          "market_total": { "type": "number" },
                          "is_live": { "type": "boolean" },
                          "confidence": { "type": "string" },
                          "direction": { "type": "string" }
                        }
                      }
                    },
                    "confidence_breakdown": {
                      "type": "object",
                      "properties": {
                        "high": { "type": "integer" },
                        "medium": { "type": "integer" },
                        "low": { "type": "integer" },
                        "neutral": { "type": "integer" }
                      }
                    },
                    "direction_breakdown": {
                      "type": "object",
                      "properties": {
                        "over": { "type": "integer" },
                        "under": { "type": "integer" },
                        "neutral": { "type": "integer" }
                      }
                    },
                    "generated_at": { "type": "string", "format": "date-time" },
                    "fresh_odds": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/live/games": {
      "get": {
        "summary": "Live Games Only",
        "description": "Returns only games that are currently in-progress (live). Cached data.",
        "operationId": "apiLiveGames",
        "tags": ["Live Predictions"],
        "responses": {
          "200": {
            "description": "Array of live games",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LiveGame" }
                }
              }
            }
          }
        }
      }
    },
    "/api/refresh": {
      "get": {
        "summary": "Refresh Dashboard Data",
        "description": "Refreshes cached dashboard data (recommendation engine) and returns summary stats.",
        "operationId": "apiRefresh",
        "tags": ["Data"],
        "responses": {
          "200": {
            "description": "Dashboard summary after refresh",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_bets": { "type": "integer" },
                    "clear_picks": { "type": "integer" },
                    "games_available": { "type": "integer" },
                    "avg_edge": { "type": "number" },
                    "total_stake": { "type": "number" },
                    "generated_at": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bets": {
      "get": {
        "summary": "List Bets with Filtering",
        "description": "Returns all bets with optional filtering by league, bet type, minimum edge, and result limit.",
        "operationId": "apiBets",
        "tags": ["Data"],
        "parameters": [
          {
            "name": "league",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "all" },
            "description": "Filter by league (e.g., NBA, WNBA) or 'all'"
          },
          {
            "name": "bet_type",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "all" },
            "description": "Filter by bet type or 'all'"
          },
          {
            "name": "min_edge",
            "in": "query",
            "required": false,
            "schema": { "type": "number", "default": 0.0 },
            "description": "Minimum edge percentage threshold"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 },
            "description": "Maximum number of results to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of bet objects sorted by edge descending",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Bet" }
                }
              }
            }
          }
        }
      }
    },
    "/api/clear-picks": {
      "get": {
        "summary": "Clear Picks",
        "description": "Returns high-confidence picks with clear scores, risk levels, and reasoning.",
        "operationId": "apiClearPicks",
        "tags": ["Data"],
        "responses": {
          "200": {
            "description": "Array of clear picks with scores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "bet": { "$ref": "#/components/schemas/Bet" },
                      "clear_score": { "type": "number" },
                      "risk_level": { "type": "string" },
                      "reasons": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/signals": {
      "get": {
        "summary": "X/Twitter Intelligence Signals",
        "description": "Returns recent signals from X/Twitter (NBA insiders, beat reporters, injury trackers) with sentiment analysis and team alerts.",
        "operationId": "apiSignals",
        "tags": ["Data"],
        "responses": {
          "200": {
            "description": "Twitter signals with summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "signals": { "type": "array" },
                    "summary": { "type": "object" },
                    "team_alerts": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stripe/config": {
      "get": {
        "summary": "Stripe Configuration",
        "description": "Returns the Stripe publishable key and whether Stripe is enabled.",
        "operationId": "stripeConfig",
        "tags": ["Payments"],
        "responses": {
          "200": {
            "description": "Stripe config",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "publishableKey": { "type": "string" },
                    "enabled": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stripe/create-checkout-session": {
      "post": {
        "summary": "Create Stripe Checkout Session",
        "description": "Creates a Stripe checkout session for subscription purchases. If Stripe is not configured, creates a demo subscription.",
        "operationId": "createCheckoutSession",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [],
                "properties": {
                  "tier": { "type": "string", "default": "basic", "description": "Subscription tier (basic, premium, pro)" },
                  "interval": { "type": "string", "default": "month", "description": "Billing interval (month, year)" },
                  "user_id": { "type": "string", "description": "Optional user ID, auto-generated if omitted" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout URL created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": { "type": "string", "description": "Redirect URL for checkout" },
                    "demo": { "type": "boolean", "description": "True if using demo mode (no Stripe configured)" },
                    "user_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Failed to create checkout session"
          }
        }
      }
    },
    "/api/stripe/create-portal-session": {
      "post": {
        "summary": "Create Stripe Customer Portal Session",
        "description": "Creates a Stripe customer portal session for managing existing subscriptions (upgrade, cancel, payment methods).",
        "operationId": "createPortalSession",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer_id"],
                "properties": {
                  "customer_id": { "type": "string", "description": "Stripe customer ID" },
                  "return_url": { "type": "string", "description": "URL to redirect after portal session" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Portal URL created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": { "type": "string", "description": "Portal session URL" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "customer_id is required"
          }
        }
      }
    },
    "/api/stripe/webhook": {
      "post": {
        "summary": "Stripe Webhook",
        "description": "Handles Stripe subscription lifecycle events (checkout.session.completed, invoice.paid, customer.subscription.updated/deleted).",
        "operationId": "stripeWebhook",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Stripe webhook event object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook received and processed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "received": { "type": "boolean", "example": true }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid signature or payload"
          }
        }
      }
    },
    "/ws/live": {
      "get": {
        "summary": "WebSocket — Live Prediction Streaming",
        "description": "WebSocket endpoint for real-time prediction streaming. On connect, sends the current snapshot. Supports commands:\n- 'refresh': re-sends cached snapshot (no API call)\n- 'ping': returns pong with timestamp",
        "operationId": "websocketLive",
        "tags": ["Live Predictions"],
        "responses": {
          "101": {
            "description": "WebSocket upgrade successful"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Landing Page",
        "description": "Returns the marketing landing page.",
        "tags": ["Pages"],
        "responses": {
          "200": {
            "description": "HTML landing page"
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "summary": "Main Dashboard",
        "description": "Main dashboard page with summary stats, clear picks, and today's card.",
        "tags": ["Pages"],
        "responses": {
          "200": {
            "description": "HTML dashboard page"
          }
        }
      }
    },
    "/live": {
      "get": {
        "summary": "Live Games Page",
        "description": "Shows live games + today's upcoming games with charts. Cached data only — use Refresh button to fetch fresh odds.",
        "tags": ["Pages"],
        "responses": {
          "200": {
            "description": "HTML live games page"
          }
        }
      }
    },
    "/pre-match-prediction": {
      "get": {
        "summary": "Pre-Match Predictions Page",
        "description": "Today + tomorrow combined predictions with edge charts and confidence breakdown.",
        "tags": ["Pages"],
        "responses": {
          "200": {
            "description": "HTML pre-match predictions page"
          }
        }
      }
    },
    "/todays-card": {
      "get": {
        "summary": "Today's Betting Card",
        "description": "Today's best bets organized by game matchup.",
        "tags": ["Pages"],
        "responses": {
          "200": {
            "description": "HTML today's card page"
          }
        }
      }
    },
    "/tomorrow": {
      "get": {
        "summary": "Tomorrow's Betting Card",
        "description": "Tomorrow's betting card with predictions and edge analysis.",
        "tags": ["Pages"],
        "responses": {
          "200": {
            "description": "HTML tomorrow's card page"
          }
        }
      }
    },
    "/all-bets": {
      "get": {
        "summary": "All Bets Page",
        "description": "All bets with HTMX sorting/filtering by league, bet type, minimum edge, and sort order.",
        "tags": ["Pages"],
        "parameters": [
          { "name": "league", "in": "query", "schema": { "type": "string", "default": "all" } },
          { "name": "bet_type", "in": "query", "schema": { "type": "string", "default": "all" } },
          { "name": "min_edge", "in": "query", "schema": { "type": "number", "default": 0.0 } },
          { "name": "sort_by", "in": "query", "schema": { "type": "string", "enum": ["edge", "stake", "confidence"], "default": "edge" } }
        ],
        "responses": {
          "200": {
            "description": "HTML all bets page"
          }
        }
      }
    },
    "/clear-picks": {
      "get": {
        "summary": "Clear Picks Page",
        "description": "High-confidence clear picks with HTMX filtering by league, bet type, and minimum edge.",
        "tags": ["Pages"],
        "parameters": [
          { "name": "league", "in": "query", "schema": { "type": "string", "default": "all" } },
          { "name": "bet_type", "in": "query", "schema": { "type": "string", "default": "all" } },
          { "name": "min_edge", "in": "query", "schema": { "type": "number", "default": 0.0 } }
        ],
        "responses": {
          "200": {
            "description": "HTML clear picks page"
          }
        }
      }
    },
    "/player-props": {
      "get": {
        "summary": "Player Props Page",
        "description": "Player prop predictions for a specific matchup.",
        "tags": ["Pages"],
        "parameters": [
          { "name": "home", "in": "query", "schema": { "type": "string", "default": "Spurs" } },
          { "name": "away", "in": "query", "schema": { "type": "string", "default": "Thunder" } },
          { "name": "league", "in": "query", "schema": { "type": "string", "default": "NBA" } }
        ],
        "responses": {
          "200": {
            "description": "HTML player props page"
          }
        }
      }
    },
    "/signals": {
      "get": {
        "summary": "X/Twitter Signals Page",
        "description": "Shows recent intelligence signals from tracked X/Twitter accounts (NBA insiders, beat reporters, injury trackers).",
        "tags": ["Pages"],
        "responses": {
          "200": {
            "description": "HTML signals page"
          }
        }
      }
    },
    "/subscribe/success": {
      "get": {
        "summary": "Subscription Success Page",
        "description": "Shown after successful subscription checkout.",
        "tags": ["Pages"],
        "parameters": [
          { "name": "session_id", "in": "query", "schema": { "type": "string" } },
          { "name": "demo", "in": "query", "schema": { "type": "string" } },
          { "name": "tier", "in": "query", "schema": { "type": "string", "default": "basic" } }
        ],
        "responses": {
          "200": {
            "description": "HTML success page"
          }
        }
      }
    },
    "/subscribe/cancel": {
      "get": {
        "summary": "Subscription Cancel Page",
        "description": "Shown when user cancels during checkout.",
        "tags": ["Pages"],
        "responses": {
          "200": {
            "description": "HTML cancel page"
          }
        }
      }
    },
    "/subscribe/manage": {
      "get": {
        "summary": "Subscription Management Page",
        "description": "Manage existing subscriptions, view stats, and access Stripe customer portal.",
        "tags": ["Pages"],
        "parameters": [
          { "name": "user_id", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "HTML manage subscriptions page"
          }
        }
      }
    },
    "/privacy": {
      "get": {
        "summary": "Privacy Policy",
        "description": "Privacy policy page.",
        "tags": ["Legal"],
        "responses": {
          "200": {
            "description": "HTML privacy policy"
          }
        }
      }
    },
    "/terms": {
      "get": {
        "summary": "Terms of Service",
        "description": "Terms of service page.",
        "tags": ["Legal"],
        "responses": {
          "200": {
            "description": "HTML terms of service"
          }
        }
      }
    },
    "/robots.txt": {
      "get": {
        "summary": "Robots Exclusion Rules",
        "description": "Standard robots.txt file for search engine crawlers.",
        "tags": ["SEO"],
        "responses": {
          "200": {
            "description": "Text robots.txt",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/sitemap.xml": {
      "get": {
        "summary": "XML Sitemap",
        "description": "XML sitemap for search engine indexing.",
        "tags": ["SEO"],
        "responses": {
          "200": {
            "description": "XML sitemap",
