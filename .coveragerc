# ═══════════════════════════════════════════════════════════════════════════
# Coverage Configuration — Betting Intelligence System
# ═══════════════════════════════════════════════════════════════════════════
#
# Usage:
#   pytest --cov=src --cov-report=term-missing
#   pytest --cov=src --cov-report=html
#
# HTML report: reports/coverage/html/index.html
# ═══════════════════════════════════════════════════════════════════════════

[run]
# Source directory to measure (must match the --cov= arg)
source = .

# Branch coverage
branch = True

# Omit non-project code
omit =
    */tests/*
    */__pycache__/*
    */.venv/*
    */venv/*
    */alembic/*

# Data file location
data_file = .coverage

[report]
fail_under = 30

# Only show src files
include =
    src/betting_intel/*

# Omit from report
omit =
    */tests/*
    */__pycache__/*
    */.venv/*
    */venv/*
    */alembic/*
    src/betting_intel/cli/main.py

exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    def __bool__
    @property
    raise NotImplementedError
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    from typing import
    if __name__ == .__main__.:
    if __name__ == '__main__':
    if __name__ == "__main__":
    pass$

ignore_errors = True
sort = Cover
precision = 1
show_missing = True
skip_covered = False
skip_empty = True

[html]
directory = reports/coverage/html
show_contexts = True

[xml]
output = reports/coverage/coverage.xml
